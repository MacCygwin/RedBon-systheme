post_install() {
    user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    [ -z "$user_home" ] && exit 0

    echo "Installing Qt color schemes for $SUDO_USER..."

    install -d "$user_home/.config/qt5ct/colors"
    install -d "$user_home/.config/qt6ct/colors"

    cp /usr/share/redbon-qt/qt5ct/colors/Catppuccin-Macchiato.conf \
       "$user_home/.config/qt5ct/colors/"

    cp /usr/share/redbon-qt/qt6ct/colors/Catppuccin-Macchiato.conf \
       "$user_home/.config/qt6ct/colors/"

    chown -R "$SUDO_USER":"$SUDO_USER" "$user_home/.config/"

    echo "Please change themes in lxappearance, nwg-look, qt5ct, and qt6ct."
}

post_upgrade() {
    post_install
}

